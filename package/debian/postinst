#!/bin/sh
set -e

case "$1" in
    configure)
        echo "[ZclockID] Running post-installation configuration..."

        # 1. Ensure UFW service is unmasked for integrated ZclockID host firewall management
        if command -v ufw >/dev/null 2>&1; then
            systemctl unmask ufw >/dev/null 2>&1 || true
        fi

        # 2. Decouple systemd-resolved stub listener from Port 53
        # Preserves host Netplan network configuration while releasing port 53 for BIND9
        if [ -f /etc/systemd/resolved.conf ]; then
            sed -i 's/^#*DNSStubListener=.*/DNSStubListener=no/' /etc/systemd/resolved.conf
            systemctl restart systemd-resolved >/dev/null 2>&1 || true
        fi

        # 3. Mask standard standalone smbd/nmbd in favor of samba-ad-dc
        systemctl stop smbd nmbd winbind >/dev/null 2>&1 || true
        systemctl disable smbd nmbd winbind >/dev/null 2>&1 || true
        systemctl mask smbd nmbd winbind >/dev/null 2>&1 || true

        # 4. Service user privilege grants
        if getent group winbindd_priv >/dev/null 2>&1; then
            usermod -aG winbindd_priv freerad >/dev/null 2>&1 || true
        fi

        # FreeRADIUS MS-CHAP & EAP 802.1X Configuration
        if [ -d /etc/freeradius/3.0 ]; then
            if [ -f /etc/zclockid/templates/freeradius/clients.conf ] && [ ! -f /etc/freeradius/3.0/clients.conf ]; then
                cp -n /etc/zclockid/templates/freeradius/clients.conf /etc/freeradius/3.0/clients.conf || true
            fi
            if [ -f /etc/zclockid/templates/freeradius/mschap ]; then
                cp -f /etc/zclockid/templates/freeradius/mschap /etc/freeradius/3.0/mods-available/mschap || true
                ln -sf /etc/freeradius/3.0/mods-available/mschap /etc/freeradius/3.0/mods-enabled/mschap || true
            fi
            if [ -f /etc/zclockid/templates/freeradius/eap ]; then
                cp -f /etc/zclockid/templates/freeradius/eap /etc/freeradius/3.0/mods-available/eap || true
                ln -sf /etc/freeradius/3.0/mods-available/eap /etc/freeradius/3.0/mods-enabled/eap || true
            fi

            # Bootstrap default FreeRADIUS certificates if missing
            if [ -d /etc/freeradius/3.0/certs ] && [ ! -f /etc/freeradius/3.0/certs/server.pem ]; then
                if [ -f /etc/freeradius/3.0/certs/bootstrap ]; then
                    chmod +x /etc/freeradius/3.0/certs/bootstrap >/dev/null 2>&1 || true
                    bash /etc/freeradius/3.0/certs/bootstrap >/dev/null 2>&1 || true
                elif [ -f /etc/freeradius/3.0/certs/Makefile ]; then
                    make -C /etc/freeradius/3.0/certs >/dev/null 2>&1 || true
                fi
            fi

            chown -R freerad:freerad /etc/freeradius/3.0 >/dev/null 2>&1 || true
            systemctl restart freeradius >/dev/null 2>&1 || true
        fi

        # Chrony NTP signing socket
        mkdir -p /var/lib/samba/ntp_signd
        chown -R root:_chrony /var/lib/samba/ntp_signd >/dev/null 2>&1 || true
        chmod 750 /var/lib/samba/ntp_signd >/dev/null 2>&1 || true

        # BIND access to Samba private directory
        mkdir -p /var/lib/samba/private
        chown -R root:bind /var/lib/samba/private >/dev/null 2>&1 || true
        chmod 750 /var/lib/samba/private >/dev/null 2>&1 || true

        # Ensure BIND RPZ Overrides DB and config exist and are included in named.conf
        mkdir -p /etc/bind/overrides
        if [ ! -f /etc/bind/overrides/rpz.overrides.db ]; then
            cat << 'EOFBIND' > /etc/bind/overrides/rpz.overrides.db
$TTL 60
@ IN SOA localhost. root.localhost. ( 1 3h 1h 1w 1h )
  IN NS localhost.
EOFBIND
        fi
        if [ ! -f /etc/bind/named.conf.overrides ]; then
            cat << 'EOFBIND' > /etc/bind/named.conf.overrides
// Autogenerated by ZclockID Management Appliance
zone "rpz.overrides" {
    type primary;
    file "/etc/bind/overrides/rpz.overrides.db";
    allow-query { any; };
};
EOFBIND
        fi
        chown -R root:bind /etc/bind/overrides /etc/bind/named.conf.overrides 2>/dev/null || true
        chmod 755 /etc/bind/overrides 2>/dev/null || true
        chmod 644 /etc/bind/overrides/rpz.overrides.db /etc/bind/named.conf.overrides 2>/dev/null || true
        if [ -f /etc/bind/named.conf ]; then
            if ! grep -q "named.conf.overrides" /etc/bind/named.conf; then
                echo 'include "/etc/bind/named.conf.overrides";' >> /etc/bind/named.conf
            fi
        fi

        # Ensure FreeRADIUS and custom overrides directory permissions
        if [ -d /zclockid/config/overrides.d ]; then
            chmod 755 /zclockid /zclockid/config /zclockid/config/overrides.d 2>/dev/null || true
            chmod 644 /zclockid/config/overrides.d/* 2>/dev/null || true
        fi

        # SNMP Telemetry helper executable
        if [ -f /opt/zclockid/scripts/zclock-telemetry.sh ]; then
            cp -f /opt/zclockid/scripts/zclock-telemetry.sh /usr/local/bin/zclock-telemetry.sh
            chmod 755 /usr/local/bin/zclock-telemetry.sh
        fi

        # Ensure official archive keyring permissions
        if [ -f /usr/share/keyrings/zclockid-archive-keyring.gpg ]; then
            chmod 644 /usr/share/keyrings/zclockid-archive-keyring.gpg 2>/dev/null || true
        fi

        # 5. Generate appliance self-signed TLS certificates if absent
        mkdir -p /etc/zclockid/certs /etc/zclockid/license /var/lib/zclockid /var/backups/zclockid /var/lib/zclockid/updates
        chmod 755 /etc/zclockid/license 2>/dev/null || true
        chown root:root /var/lib/zclockid/updates 2>/dev/null || true
        chmod 700 /var/lib/zclockid/updates 2>/dev/null || true
        if [ ! -f /etc/zclockid/certs/appliance.crt ]; then
            openssl req -x509 -nodes -days 1825 -newkey rsa:2048 \
                -keyout /etc/zclockid/certs/appliance.key \
                -out /etc/zclockid/certs/appliance.crt \
                -subj "/CN=$(hostname -f 2>/dev/null || echo 'zclockid.local')/O=ZclockID Enterprise/OU=Appliance" >/dev/null 2>&1 || true
            chmod 600 /etc/zclockid/certs/appliance.key
        fi

        # 6. Configure Nginx Ingress Reverse Proxy
        if [ -f /etc/nginx/sites-available/zclockid.conf ]; then
            rm -f /etc/nginx/sites-enabled/default >/dev/null 2>&1 || true
            ln -sf /etc/nginx/sites-available/zclockid.conf /etc/nginx/sites-enabled/
            systemctl restart nginx >/dev/null 2>&1 || true
        fi

        # 7. Ensure FastAPI multipart support is verified
        if ! python3 -c "import multipart" >/dev/null 2>&1; then
            pip3 install --break-system-packages python-multipart >/dev/null 2>&1 || true
        fi

        # 8. Run database migrations and schema initialization
        PYTHONPATH=/opt/zclockid python3 -m api.db.init_db >/dev/null 2>&1 || true

        # 9. Reload systemd units and restart services
        systemctl daemon-reload
        systemctl enable zclock-api.service zclock-sysvold.service zclock-azuresync.service zclock-exporter.service >/dev/null 2>&1 || true
        systemctl restart zclock-api.service zclock-sysvold.service zclock-exporter.service >/dev/null 2>&1 || true

        echo ""
        echo "================================================================="
        echo "   ZclockID Active Directory & IAM Appliance Installed!          "
        echo "================================================================="
        echo "Web Management Console: https://$(hostname -I 2>/dev/null | awk '{print $1}' || echo '<server-ip>')/"
        echo "First-Time Setup:       https://$(hostname -I 2>/dev/null | awk '{print $1}' || echo '<server-ip>')/setup.html"
        echo "Self-Registration:      https://$(hostname -I 2>/dev/null | awk '{print $1}' || echo '<server-ip>')/register.html"
        echo "Password Reset Portal:  https://$(hostname -I 2>/dev/null | awk '{print $1}' || echo '<server-ip>')/password-reset.html"
        echo "================================================================="
        echo ""
        ;;
esac

exit 0
