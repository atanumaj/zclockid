[Unit]
Description=ZclockID Sysvol Synchronization & NTACL Self-Healing Daemon (Go Native)
After=network.target samba-ad-dc.service
Requires=samba-ad-dc.service

[Service]
Type=simple
User=root
ExecStart=/opt/zclockid/bin/zclock-sysvold
Restart=always
RestartSec=5s
Environment=SYSVOL_PATH=/var/lib/samba/sysvol
Environment=DEBOUNCE_SECONDS=5

[Install]
WantedBy=multi-user.target

